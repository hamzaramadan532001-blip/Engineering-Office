# ═══════════════════════════════════════════════════════════════════════════════
#  Makkah GIS Viewer — production environment (Windows Server / IIS)
# ═══════════════════════════════════════════════════════════════════════════════
#  1. Copy this file next to server.js and rename it to:   .env
#  2. Fill in every REQUIRED value.
#  3. Restart the app. The file is read once at startup — edits need a restart,
#     never a rebuild.
#  Do NOT also place a .env.local here: it overrides .env.
#
#  NEXT_PUBLIC_* variables are fixed at build time and are ignored in this file.
#  See RUNBOOK.md for the full deployment procedure.
# ═══════════════════════════════════════════════════════════════════════════════

# ── ArcGIS tokens sent to the browser ────────────────────────────────────────
# Tokens are usually bound to a Referer/IP. Generate them for the address users
# open (e.g. https://qamaps.holymakkah.gov.sa), NOT http://localhost:3000 —
# otherwise every layer fails with "Invalid Token (498)".
#
# REQUIRED — geoportal token (portal, dashboards, 3D scene).
ARCGIS_TOKEN=
# REQUIRED — token for the requests table, BusinessMap layers and attestations
# (Regulation571EditTrans / BusinessMap). Falls back to ARCGIS_TOKEN when empty.
BUSINESS_MAP_TOKEN=

# ── ArcGIS token used by the server only (never sent to the browser) ─────────
# REQUIRED — engineering-office login, admin login, request attachments.
# Must be valid when called FROM THIS SERVER (no Referer, this server's IP).
ARCGIS_SERVER_TOKEN=

# ── Sessions ─────────────────────────────────────────────────────────────────
# REQUIRED — random string, at least 32 characters. Encrypts the login cookie.
SESSION_SECRET=
# SESSION_COOKIE=mmsdi_session
# SESSION_TTL_SEC=2592000
# GUEST_SESSION_TTL_SEC=14400

# ── Admin panel (/gis-viewer-eng/admin) ──────────────────────────────────────
# REQUIRED in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Permissions ──────────────────────────────────────────────────────────────
# URL of the permissions-api. Leave EMPTY when there is none.
PERMISSIONS_API_URL=
# "on" (default) or "off". "off" only when PERMISSIONS_API_URL is empty — every
# widget and layer becomes visible to everyone. Never "off" with real data.
PERMISSIONS_ENFORCEMENT=on
# "hidden" hides the "permissions not enforced" banner.
# PERMISSIONS_UNENFORCED_NOTICE=

# ── ArcGIS service URLs (optional) ───────────────────────────────────────────
# Unset = production services. Set only what differs in this environment
# (e.g. QA hosts). Leave a line commented rather than empty.
# ARCGIS_REGULATION_TRANSACTIONS_URL=https://maps.holymakkah.gov.sa/arcgis/rest/services/SDI/Regulation571EditTrans/FeatureServer
# ARCGIS_PORTAL_URL=https://geoportal.holymakkah.gov.sa/portal
# ARCGIS_MUNICIPAL_ASSETS_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/MunicipalAssetV1/MapServer
# ARCGIS_COMPLAINTS_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/Complain_MIL1/FeatureServer/0
# ARCGIS_CHANGE_DETECTION_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/ChangeDetictionVer2_MIL1/MapServer
# ARCGIS_EXECUTIVE_DASHBOARD_URL=https://maps.holymakkah.gov.sa/arcgis/rest/services/SDI/BusinessMapgisViewerSdiV5/MapServer
# ARCGIS_BUSINESS_MAP_URL=https://maps.holymakkah.gov.sa/arcgis/rest/services/SDI/MMSDI_MD_BusinessMap/MapServer
# ARCGIS_BASEMAP_V1_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Basemaps/BasemapV1Cach2/MapServer
# ARCGIS_BASEMAP_V2_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Basemaps/BasemapV2/MapServer
# ARCGIS_BASEMAP_HYBRID_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Basemaps/BasemapHybridV1Cache1/MapServer
# ARCGIS_RASTER_FOLDER_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Raster
# ARCGIS_PRINT_SERVICE_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/Utilities/PrintingTools/GPServer/Export%20Web%20Map%20Task

# ── 3D scene / basemap Portal items (optional) ───────────────────────────────
# ARCGIS_SCENE_WEBSCENE_ID=774eff45bd34490ba403221be1213811
# ARCGIS_SCENE_BASEMAP_ID=30699b07b44f47ef929b9e216594a7db
# ARCGIS_GALLERY_IMAGERY_ID=30699b07b44f47ef929b9e216594a7db
