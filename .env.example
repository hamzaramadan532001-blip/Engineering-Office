# Frontend env. Nafath itself, the Oracle identity mapping and JWT issuance live
# in the permissions-api (a SEPARATE server) — its secrets do NOT belong here.

# Backend API base. Empty = same-origin (local dev-mock under /api/*).
# NEXT_PUBLIC_API_BASE_URL=https://api.makkah.gov.sa

# ── Permissions API (server-side BFF target) ─────────────────────────────────
# When set, the Nafath BFF routes (src/app/api/auth/nafath/*) proxy to the
# permissions-api instead of the in-process dev mock. Server-only — NEVER expose
# with a NEXT_PUBLIC_ prefix. The permissions-api defaults to port 3001 and
# serves everything under /api/v1. Leave unset for the no-backend dev mock.
# PERMISSIONS_API_URL=http://localhost:3001

# Permission enforcement switch: "on" (default) or "off". ONLY a literal "off"
# turns gating off — an unset PERMISSIONS_API_URL in production still throws, and
# any other value (false/0/disabled) is a hard error, never a silent fail-open.
#
# "off" is for ONE situation: deploying the viewer BEFORE the permissions-api
# exists. It makes the server serve no grants at all, so every widget and layer is
# visible to everyone, the session is presence-only (any non-empty cookie counts as
# logged in, nothing verified), login falls back to the in-process Nafath dev mock
# when PERMISSIONS_API_URL is unset, and an Arabic banner tells every user that
# permissions are not enforced. It also wins over PERMISSIONS_API_URL when both are
# set — the explicit switch is the deliberate signal.
#
# ⚠️ NEVER set "off" once the permissions service is live, and never on an
# environment holding real data. Remove the variable to restore enforcement.
# PERMISSIONS_ENFORCEMENT=on

# Secret that encrypts the session cookie (jose JWE — carries the permissions-api
# JWT pair + user server-side). Any string; it is hashed to a 32-byte key. Set a
# strong random value in every real environment. Server-only.
# SESSION_SECRET=change-me-in-production

# Session cookie name (must match nothing external now — the BFF owns the cookie).
# SESSION_COOKIE=mmsdi_session
# SESSION_TTL_SEC=3600

# Guest sessions (PERM-22): a Nafath-verified national ID with no SDIUSERS row.
# The guest cookie holds no token pair, so it cannot rotate — kept short (default 4h).
# GUEST_SESSION_TTL_SEC=14400

# Dev-mock only: number-validity window shown on the verify screen.
# NAFATH_MOCK_EXPIRY_SEC=60

# ArcGIS token for the Holy Makkah geoportal MapServer — powers the dashboard's
# live data, the map FeatureLayers, and the 3D WebScene.
#
# TWO ways to provide it (resolved in this order at runtime — see lib/runtimeConfig.ts):
#   1. ARCGIS_TOKEN (server-only, NOT exposed)  — read at runtime and injected into
#      the page. This is how self-hosted (Windows) deploys stay environment-agnostic:
#      set it in `makkah-gis.env` next to start.js, or in the Vercel project env.
#      Preferred for deploys: one build runs anywhere; change the token without a rebuild.
#   2. NEXT_PUBLIC_ARCGIS_TOKEN (build-time fallback) — baked into the browser bundle.
#      Convenient for local dev (.env.local); NOTE it is exposed in the client bundle.
# ARCGIS_TOKEN=
# NEXT_PUBLIC_ARCGIS_TOKEN=

# ArcGIS token for the secured BusinessMap server (maps.holymakkah.gov.sa) — the
# Layers List's operational layers + Attestations. Same two-tier resolution as above
# (ARCGIS_TOKEN's runtime var is BUSINESS_MAP_TOKEN). Falls back to the geoportal token
# when unset. ArcGIS Server tokens expire (default ~60 min) — use long-lived ones for deploys.
# BUSINESS_MAP_TOKEN=
# NEXT_PUBLIC_BUSINESS_MAP_TOKEN=

# Optional allow-list override for the Layers List: comma-separated layer ids from
# OPERATIONAL_LAYERS in features/Map/arcgis.config.ts. Unset = every layer with
# `enabled: true` in the config.
# NEXT_PUBLIC_ENABLED_LAYERS=districts,haram-boundary,urban-boundary

# ── ArcGIS service URLs (per environment) ────────────────────────────────────
# FULL service URLs, not just hosts: environments differ by host, web-adaptor path
# (prod `/arcgis/rest/services` vs QA `/server/rest/services`), AND service name
# (MunicipalAssetV1 vs Dashboard/Dashboard), so each URL is overridable on its own.
# Read at runtime and injected (same mechanism as the tokens above) so one build
# targets QA vs production by env file alone — no rebuild. Each falls back to the
# production value below when unset, so an environment only sets what differs.
# ARCGIS_PORTAL_URL=https://geoportal.holymakkah.gov.sa/portal
# ARCGIS_MUNICIPAL_ASSETS_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/MunicipalAssetV1/MapServer
# ARCGIS_COMPLAINTS_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/Complain_MIL1/FeatureServer/0
# ARCGIS_EXECUTIVE_DASHBOARD_URL=https://maps.holymakkah.gov.sa/arcgis/rest/services/SDI/BusinessMapgisViewerSdiV5/MapServer
# ARCGIS_CHANGE_DETECTION_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/ChangeDetictionVer2_MIL1/MapServer
# ARCGIS_BUSINESS_MAP_URL=https://maps.holymakkah.gov.sa/arcgis/rest/services/SDI/MMSDI_MD_BusinessMap/MapServer
# ARCGIS_BASEMAP_V1_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Basemaps/BasemapV1Cach2/MapServer
# ARCGIS_BASEMAP_V2_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Basemaps/BasemapV2/MapServer
# ARCGIS_BASEMAP_HYBRID_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Basemaps/BasemapHybridV1Cache1/MapServer
# ARCGIS_RASTER_FOLDER_URL=https://sdi.holymakkah.gov.sa/arcgis/rest/services/Raster
# ARCGIS_PRINT_SERVICE_URL=https://geoportal.holymakkah.gov.sa/arcgis/rest/services/Utilities/PrintingTools/GPServer/Export%20Web%20Map%20Task

# ── 3D scene Portal item ids (per environment) ───────────────────────────────
# The WebScene and its "Imagery with Labels" basemap are Portal items whose ids
# differ per environment. Same runtime injection; fall back to the production ids.
# ARCGIS_SCENE_WEBSCENE_ID=774eff45bd34490ba403221be1213811
# ARCGIS_SCENE_BASEMAP_ID=30699b07b44f47ef929b9e216594a7db

# The imagery entry (صور جوية) in the basemap picker — its own setting, decoupled from
# ARCGIS_SCENE_BASEMAP_ID so the 3D scene choice never changes the picker list.
# Accepts a Portal item id, "osm", a tile-service URL, or "none" (hide the entry).
# ARCGIS_GALLERY_IMAGERY_ID=30699b07b44f47ef929b9e216594a7db
